\cf6 '''\
7. Supplementary Functions\
'''\
\cf4 def \cf10 _ensure_dir\cf5 (p: \cf8 str\cf5 ):\
    os.makedirs(p, \cf11 exist_ok\cf5 =\cf4 True\cf5 )\
\
\cf4 def \cf10 discover_datasets\cf5 (base_dir: \cf8 str\cf5 , require_tmc: \cf8 bool \cf5 = \cf4 False\cf5 ):\
    TEST_RE = re.compile(\cf6 r"\cb15 ^(.+?)_test_(\\d+)(?:\\.[^.]+)?$\cb3 "\cf5 )\
    TMC_RE = re.compile(\cf6 r"\cb15 ^(.+?)_TMC_(\\d+)(?:\\.[^.]+)?$\cb3 "\cf5 )\
    TRAIN_RE = re.compile(\cf6 r"\cb15 ^(.+?)_(\\d+)(?:\\.[^.]+)?$\cb3 "\cf5 )\
\
    bucket = \{\}\
    \cf4 for \cf5 fn \cf4 in \cf5 os.listdir(base_dir):\
        base = fn\
        path = os.path.join(base_dir, fn)\
\
        m = TEST_RE.match(base)\
        \cf4 if \cf5 m:\
            key = (m.group(\cf7 1\cf5 ), m.group(\cf7 2\cf5 ))\
            bucket.setdefault(key, \{\})[\cf6 "test"\cf5 ] = path\
            \cf4 continue\
\
        \cf5 m = TMC_RE.match(base)\
        \cf4 if \cf5 m:\
            key = (m.group(\cf7 1\cf5 ), m.group(\cf7 2\cf5 ))\
            bucket.setdefault(key, \{\})[\cf6 "tmc"\cf5 ] = path\
            \cf4 continue\
\
        if \cf5 TEST_RE.match(base) \cf4 or \cf5 TMC_RE.match(base):\
            \cf4 continue\
        \cf5 m = TRAIN_RE.match(base)\
        \cf4 if \cf5 m:\
            key = (m.group(\cf7 1\cf5 ), m.group(\cf7 2\cf5 ))\
            bucket.setdefault(key, \{\})[\cf6 "train_like"\cf5 ] = path\
            \cf4 continue\
\
    \cf5 result = []\
    \cf4 for \cf5 key, paths \cf4 in \cf5 bucket.items():\
        tr = paths.get(\cf6 "train_like"\cf5 ); te = paths.get(\cf6 "test"\cf5 ); tm = paths.get(\cf6 "tmc"\cf5 )\
        \cf4 if \cf5 tr \cf4 and \cf5 te \cf4 and \cf5 (tm \cf4 or not \cf5 require_tmc):\
            stem, idx = key\
            base_name = \cf6 f"\cf4 \{\cf5 stem\cf4 \}\cf6 _\cf4 \{\cf5 idx\cf4 \}\cf6 "\
            \cf5 result.append(\{\
                \cf6 "key"\cf5 : key,\
                \cf6 "base_name"\cf5 : base_name,\
                \cf6 "train_like"\cf5 : tr,\
                \cf6 "test"\cf5 : te,\
                \cf6 "tmc"\cf5 : tm\
            \})\
        \cf4 else\cf5 :\
            stem, idx = key\
            want = []\
            \cf4 if not \cf5 paths.get(\cf6 "train_like"\cf5 ): want.append(\cf6 "train_like"\cf5 )\
            \cf4 if not \cf5 paths.get(\cf6 "test"\cf5 ):       want.append(\cf6 "test"\cf5 )\
            \cf4 if \cf5 require_tmc \cf4 and not \cf5 paths.get(\cf6 "tmc"\cf5 ): want.append(\cf6 "tmc"\cf5 )\
