\cf6 '''\
6. Prediction\
'''\
\cf4 def \cf10 predict\cf5 (model, data_list):\
    model.eval()\
    \cf4 with \cf5 torch.no_grad():\
        yhat_scaled = model(data_list).view(-\cf7 1\cf5 )\
        total_util = data_list[\cf7 0\cf5 ].total_util.to(yhat_scaled.device)\
        N = data_list[\cf7 0\cf5 ].x.size(\cf7 0\cf5 )\
        descaled = yhat_scaled * (total_util / N)\
        \cf4 return \cf5 descaled.cpu().numpy()\
\
