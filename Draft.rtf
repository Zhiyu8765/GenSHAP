\cf6 '''\
2. Graph Construction\
'''\
\cf5 C_List = [\cf7 0.25\cf5 , \cf7 0.5\cf5 , \cf7 1\cf5 , \cf7 2\cf5 , \cf7 4\cf5 , \cf7 8\cf5 ]\
\
\cf4 def \cf10 build_graph\cf5 (X_raw, y_raw, phi, total_util, c, loo_z, grad_norm_z, grad_err_z, loss_stats_z, d=svd_d):\
    D = pairwise_distances(X_raw, \cf11 metric\cf5 =\cf6 'euclidean'\cf5 )\
    \cf9 # D = pairwise_distances(X_raw, metric='manhattan')\
    # ## Gaussian Kernel\
    # sigma = np.mean(D)\
    # A = np.exp(-(D ** 2) / (2 * (c * sigma) ** 2))\
    ### Laplace Kernel\
    # sigma = np.mean(D)\
    # eps = 1e-12\
    # A = np.exp(-D / (c * sigma + eps))\
    ## Student t kernel\
    \cf5 sigma = np.mean(D)\
    nu = \cf7 1.0\
    \cf5 eps = \cf7 1e-12\
    \cf5 scale2 = (c * sigma + eps) ** \cf7 2\
    \cf5 A = (\cf7 1.0 \cf5 + (D ** \cf7 2\cf5 ) / (nu * scale2)) ** (-(nu + \cf7 2.0\cf5 ) / \cf7 2.0\cf5 )\
\
    \cf9 ## Injection of Local Distance Skewness\
    \cf4 def \cf10 _standardize\cf5 (arr):\
        mu = arr.mean()\
        std = arr.std()\
        \cf4 if \cf5 std < \cf7 1e-12\cf5 :\
            \cf4 return \cf5 np.zeros_like(arr)\
        \cf4 return \cf5 (arr - mu) / std\
\
    \cf4 def \cf10 _skewness_1d\cf5 (v, eps=\cf7 1e-12\cf5 ):\
        v = np.asarray(v)\
        m = v.mean()\
        c = v - m\
        s2 = np.mean(c**\cf7 2\cf5 )\
        s = np.sqrt(s2 + eps)\
        \cf4 return \cf5 np.mean(c**\cf7 3\cf5 ) / (s**\cf7 3 \cf5 + eps)\
\
    \cf4 def \cf10 _kurtosis_1d\cf5 (v, eps=\cf7 1e-12\cf5 ):\
        v = np.asarray(v, \cf11 dtype\cf5 =\cf8 float\cf5 )\
        m = v.mean()\
        c = v - m\
        s2 = np.mean(c ** \cf7 2\cf5 )\
        s4 = (s2 + eps) ** \cf7 2\
        \cf4 return \cf5 np.mean(c ** \cf7 4\cf5 ) / s4 - \cf7 3.0\
\
    \cf9 # # Injection of skewness (treat each row as random samples from one distribution)\
    # Xr = np.asarray(X_raw, dtype=float)\
    # skew_feat = np.array([_skewness_1d(Xr[i]) for i in range(Xr.shape[0])], dtype=float)  # (N,)\
    # skew_dist_z = _standardize(skew_feat)  # (N,)\
\
    # Injection of more statistics\
    \cf5 Xr = np.asarray(X_raw, \cf11 dtype\cf5 =\cf8 float\cf5 )\
    row_mean = Xr.mean(\cf11 axis\cf5 =\cf7 1\cf5 )\
    row_var = Xr.var(\cf11 axis\cf5 =\cf7 1\cf5 )\
    row_min = Xr.min(\cf11 axis\cf5 =\cf7 1\cf5 )\
    row_max = Xr.max(\cf11 axis\cf5 =\cf7 1\cf5 )\
    row_skew = np.array([_skewness_1d(Xr[i]) \cf4 for \cf5 i \cf4 in \cf8 range\cf5 (Xr.shape[\cf7 0\cf5 ])])\
    row_kurt = np.array([_kurtosis_1d(Xr[i]) \cf4 for \cf5 i \cf4 in \cf8 range\cf5 (Xr.shape[\cf7 0\cf5 ])])\
\
    stats = np.vstack([row_mean, row_var, row_min, row_max, row_skew, row_kurt]).T  \cf9 # (N, 6)\
    \cf5 stats_z = np.column_stack([_standardize(stats[:, j]) \cf4 for \cf5 j \cf4 in \cf8 range\cf5 (stats.shape[\cf7 1\cf5 ])])\
\
    X_svd = SVD_Transform(A, \cf11 d \cf5 = d)\
    y = np.asarray(y_raw).ravel()\
    A_y = (y[:, \cf4 None\cf5 ] == y[\cf4 None\cf5 , :]).astype(\cf8 float\cf5 )\
\
    \cf9 # # Injection of LOO (standardised)\
    # loo_z = np.asarray(loo_z).reshape(-1, 1)  # (N, 1)\
    # X_node = np.concatenate([X_svd, loo_z], axis=1)  # (N, svd_d + 1)\
\
    ## Injection of LOO + Gradient Norm + Grad Error\
    \cf5 loo_z = np.asarray(loo_z).reshape(-\cf7 1\cf5 , \cf7 1\cf5 )  \cf9 # (N, 1)\
    \cf5 grad_norm_z = np.asarray(grad_norm_z).reshape(-\cf7 1\cf5 , \cf7 1\cf5 )  \cf9 # (N, 1)\
    \cf5 grad_err_z = np.asarray(grad_err_z).reshape(-\cf7 1\cf5 , \cf7 1\cf5 )  \cf9 # (N, 1)\
\
    ## weight on injected features\
    \cf5 weight_extra = \cf7 1.0\
    \cf9 # extra_feats = np.concatenate([loo_z, grad_norm_z, grad_err_z], axis=1)  # (N, 3)\
    # extra_feats *= weight_extra\
    # X_node = np.concatenate([X_svd, extra_feats], axis=1)  # (N, svd_d + 3)\
    ## Injection of LOO + Gradient Norm + Grad Error + Local distance-skewness\
    # skew_dist_z = np.asarray(skew_dist_z).reshape(-1, 1)\
    # extra_feats = np.concatenate([loo_z, grad_norm_z, grad_err_z, skew_dist_z], axis=1)\
    ## Injection of row statistics\
    \cf5 extra_feats = np.concatenate([loo_z, grad_norm_z, grad_err_z, stats_z, loss_stats_z], \cf11 axis\cf5 =\cf7 1\cf5 )  \cf9 # (N, 9)\
    \cf5 extra_feats *= weight_extra\
    X_node = np.concatenate([X_svd, extra_feats], \cf11 axis\cf5 =\cf7 1\cf5 )\
\
\
    N = X_raw.shape[\cf7 0\cf5 ]\
    src, dst = np.triu_indices(N, \cf11 k\cf5 =\cf7 1\cf5 )\
    eidx = np.vstack([src, dst])\
    edge_index = torch.tensor(\
        np.concatenate([eidx, eidx[::-\cf7 1\cf5 ]], \cf11 axis\cf5 =\cf7 1\cf5 ),\
        \cf11 dtype\cf5 =torch.long, \cf11 device\cf5 =device\
    )\
\
    w_feat = A[src, dst]\
    w_label = A_y[src, dst]\
    edge_attr_feat = torch.tensor(\
        np.concatenate([w_feat, w_feat]),\
        \cf11 dtype\cf5 =torch.float, \cf11 device\cf5 =device\
    ).unsqueeze(\cf7 1\cf5 )\
    edge_attr_label = torch.tensor(\
        np.concatenate([w_label, w_label]),\
        \cf11 dtype\cf5 =torch.float, \cf11 device\cf5 =device\
    ).unsqueeze(\cf7 1\cf5 )\
\
    data = Data(\
        \cf11 x\cf5 =torch.tensor(X_node, \cf11 dtype\cf5 =torch.float, \cf11 device\cf5 =device),  \cf9 # use X_node\
        \cf11 edge_index\cf5 =edge_index,\
        \cf11 edge_attr_feat\cf5 =edge_attr_feat,\
        \cf11 edge_attr_label\cf5 =edge_attr_label\
    )\
\
    \cf9 # Extra attributes\
    \cf5 data.X_raw = torch.tensor(X_raw, \cf11 dtype\cf5 =torch.float, \cf11 device\cf5 =device)\
    data.phi = torch.tensor(phi, \cf11 dtype\cf5 =torch.float, \cf11 device\cf5 =device)\
    data.total_util = torch.tensor(total_util, \cf11 dtype\cf5 =torch.float, \cf11 device\cf5 =device)\
    data.y = torch.tensor(y_raw, \cf11 dtype\cf5 =torch.long, \cf11 device\cf5 =device)\
    data.num_classes = \cf8 int\cf5 (\cf8 len\cf5 (np.unique(y)))\
\
    \cf9 # Record number of classes of each dataset\
    \cf5 K = \cf8 int\cf5 (np.unique(y).size)\
    k_vec = np.array([K, \cf7 1.0 \cf5 / \cf8 max\cf5 (\cf7 1\cf5 , K), np.log1p(K)], \cf11 dtype\cf5 =\cf8 float\cf5 )\
    data.k_feat = torch.tensor(np.tile(k_vec, (N, \cf7 1\cf5 )), \cf11 dtype\cf5 =torch.float, \cf11 device\cf5 =device)\
\
    \cf9 # # Keep LOO_z for diagnostics\
    # data.loo_z = torch.tensor(loo_z, dtype=torch.float, device=device)\
\
    ## Keep LOO_z, grad_norm_z, grad_err_z for diagnostics\
    \cf5 data.loo_z = torch.tensor(loo_z, \cf11 dtype\cf5 =torch.float, \cf11 device\cf5 =device)\
    data.grad_norm_z = torch.tensor(grad_norm_z, \cf11 dtype\cf5 =torch.float, \cf11 device\cf5 =device)\
    data.grad_err_z  = torch.tensor(grad_err_z, \cf11 dtype\cf5 =torch.float, \cf11 device\cf5 =device)\
    \cf9 # data.skew_dist_z = torch.tensor(skew_dist_z, dtype=torch.float, device=device)\
    \cf5 data.stats_z = torch.tensor(stats_z, \cf11 dtype\cf5 =torch.float, \cf11 device\cf5 =device)\
    \cf4 return \cf5 data\
\
\cf6 '''\
3. Data Preprocessing\
'''\
'Record loss history in training Logistic Regression (Using Pytorch)'\
\cf4 def \cf10 loss_history_LR\cf5 (X_raw, y_raw, epochs=\cf7 100\cf5 , log_every=\cf7 1\cf5 , lr=\cf7 1e-1\cf5 ,\
                    device=\cf6 "cpu"\cf5 , seed=\cf7 23\cf5 , eps=\cf7 1e-12\cf5 ):\
    torch.manual_seed(seed)\
    np.random.seed(seed)\
\
    X = torch.tensor(np.asarray(X_raw), \cf11 dtype\cf5 =torch.float32, \cf11 device\cf5 =device)\
    y = torch.tensor(np.asarray(y_raw).astype(\cf8 int\cf5 ), \cf11 dtype\cf5 =torch.long, \cf11 device\cf5 =device)\
    N, d = X.shape\
    K = \cf8 int\cf5 (torch.unique(y).numel())\
\
    W = torch.zeros(d, K, \cf11 device\cf5 =device, \cf11 requires_grad\cf5 =\cf4 True\cf5 )\
    b = torch.zeros(K, \cf11 device\cf5 =device, \cf11 requires_grad\cf5 =\cf4 True\cf5 )\
\
    opt = torch.optim.Adam([W, b], \cf11 lr\cf5 =lr)\
\
    loss_hist = []\
    \cf4 for \cf5 ep \cf4 in \cf8 range\cf5 (\cf7 1\cf5 , epochs + \cf7 1\cf5 ):\
        logits = X @ W + b\
        loss = F.cross_entropy(logits, y, \cf11 reduction\cf5 =\cf6 "mean"\cf5 )\
        opt.zero_grad(\cf11 set_to_none\cf5 =\cf4 True\cf5 )\
        loss.backward()\
        opt.step()\
\
        \cf4 if \cf5 (ep % log_every == \cf7 0\cf5 ) \cf4 or \cf5 (ep == epochs):\
            \cf4 with \cf5 torch.no_grad():\
                logits_t = X @ W + b\
                per_sample = F.cross_entropy(logits_t, y, \cf11 reduction\cf5 =\cf6 "none"\cf5 )  \cf9 # (N,)\
                \cf5 loss_hist.append(per_sample.detach().cpu().numpy())\
\
    L = np.stack(loss_hist, \cf11 axis\cf5 =\cf7 1\cf5 )  \cf9 # (N, T)\
    \cf5 mu = L.mean(\cf11 axis\cf5 =\cf7 1\cf5 )\
    var = L.var(\cf11 axis\cf5 =\cf7 1\cf5 )\
    mn = L.min(\cf11 axis\cf5 =\cf7 1\cf5 )\
    mx = L.max(\cf11 axis\cf5 =\cf7 1\cf5 )\
\
    c = L - mu[:, \cf4 None\cf5 ]\
    s2 = (c**\cf7 2\cf5 ).mean(\cf11 axis\cf5 =\cf7 1\cf5 ) + eps\
    s = np.sqrt(s2)\
    skew = (c**\cf7 3\cf5 ).mean(\cf11 axis\cf5 =\cf7 1\cf5 ) / (s**\cf7 3 \cf5 + eps)\
    kurt = (c**\cf7 4\cf5 ).mean(\cf11 axis\cf5 =\cf7 1\cf5 ) / (s2**\cf7 2 \cf5 + eps) - \cf7 3.0\
\
    \cf5 stats = np.vstack([mu, var, mn, mx, skew, kurt]).T  \cf9 # (N, 6)\
    \cf4 return \cf5 stats\
\
\cf4 def \cf10 load_and_preprocess\cf5 (train_csv, test_csv, d = svd_d):\
    df_train = pd.read_csv(train_csv)\
    X_raw = df_train.drop(\cf11 columns\cf5 =[\cf6 'target'\cf5 ,\cf6 'PerDShap'\cf5 ]).astype(\cf8 float\cf5 ).to_numpy()\
    \cf9 # X_raw = df_train.drop(columns=['target', 'TrueDShap']).astype(float).to_numpy()\
    \cf5 y_raw = df_train[\cf6 'target'\cf5 ].to_numpy().astype(\cf8 int\cf5 )\
    phi = df_train[\cf6 'PerDShap'\cf5 ].to_numpy()\
    \cf9 # phi = df_train['TrueDShap'].to_numpy()\
    \cf5 df_test = pd.read_csv(test_csv)\
    X_test = df_test.drop(\cf11 columns\cf5 =[\cf6 'target'\cf5 ]).astype(\cf8 float\cf5 ).to_numpy()\
    y_test = df_test[\cf6 'target'\cf5 ].to_numpy().astype(\cf8 int\cf5 )\
\
    lr_full = LogisticRegression(\cf11 max_iter \cf5 = \cf7 100\cf5 , \cf11 random_state\cf5 =\cf7 23\cf5 )\
    lr_full.fit(X_raw, y_raw)\
    model_acc = lr_full.score(X_test, y_test)\
    total_util = model_acc\
\
    \cf9 ## Compute gradient  info\
    \cf12 n\cf5 , \cf12 d_feat \cf5 = X_raw.shape\
    P = lr_full.predict_proba(X_raw)  \cf9 # (N, C)\
    \cf5 classes = lr_full.classes_  \cf9 # shape (C,)\
    \cf5 class_to_idx = \{c: i \cf4 for \cf5 i, c \cf4 in \cf8 enumerate\cf5 (classes)\}\
\
    n = X_raw.shape[\cf7 0\cf5 ]\
    col_idx = np.array([class_to_idx[y] \cf4 for \cf5 y \cf4 in \cf5 y_raw])  \cf9 # (N,)\
\
    \cf5 Y_onehot = np.zeros_like(P)\
    Y_onehot[np.arange(n), col_idx] = \cf7 1.0\
\
    \cf5 grad_w = (P - Y_onehot)[:, :, \cf4 None\cf5 ] * X_raw[:, \cf4 None\cf5 , :]  \cf9 # (N, C, d_feat)\
    \cf5 grad_norm = np.linalg.norm(grad_w, \cf11 axis\cf5 =(\cf7 1\cf5 , \cf7 2\cf5 ))  \cf9 # (N,)\
\
    \cf5 p_true = P[np.arange(n), col_idx]  \cf9 # (N,)\
    \cf5 grad_err = \cf7 1.0 \cf5 - p_true\
    \cf4 def \cf10 _standardize\cf5 (arr):\
        mu = arr.mean()\
        std = arr.std()\
        \cf4 if \cf5 std < \cf7 1e-12\cf5 :\
            \cf4 return \cf5 np.zeros_like(arr)\
        \cf4 return \cf5 (arr - mu) / std\
\
    grad_norm_z = _standardize(grad_norm)\
    grad_err_z  = _standardize(grad_err)\
\
    \cf9 ## Injection of Loss History statistics\
    \cf5 loss_stats = loss_history_LR(X_raw, y_raw, \cf11 epochs\cf5 =\cf7 100\cf5 , \cf11 log_every\cf5 =\cf7 1\cf5 , \cf11 lr\cf5 =\cf7 1e-1\cf5 , \cf11 device \cf5 = device)\
    loss_stats_z = np.column_stack([_standardize(loss_stats[:, j]) \cf4 for \cf5 j \cf4 in \cf8 range\cf5 (loss_stats.shape[\cf7 1\cf5 ])])\
\
    \cf9 ## Compute LOO values\
    \cf5 n = X_raw.shape[\cf7 0\cf5 ]\
    loo_raw = np.zeros(n, \cf11 dtype\cf5 =\cf8 float\cf5 )\
\
    \cf4 for \cf5 i \cf4 in \cf8 range\cf5 (n):\
        mask = np.ones(n, \cf11 dtype\cf5 =\cf8 bool\cf5 )\
        mask[i] = \cf4 False\
\
        \cf5 lr_i = LogisticRegression(\cf11 max_iter\cf5 =\cf7 100\cf5 , \cf11 random_state\cf5 =\cf7 23\cf5 )\
        lr_i.fit(X_raw[mask], y_raw[mask])\
        acc_i = lr_i.score(X_test, y_test)\
\
        loo_raw[i] = model_acc - acc_i  \cf9 # LOO_i = U(D) - U(D\\\{i\})\
    \cf5 mu = loo_raw.mean()\
    std = loo_raw.std()\
    \cf4 if \cf5 std < \cf7 1e-12\cf5 :\
        loo_z = np.zeros_like(loo_raw)\
    \cf4 else\cf5 :\
        loo_z = (loo_raw - mu) / std\
\
    data_list = []\
    \cf4 for \cf5 c \cf4 in \cf5 C_List:\
        \cf9 # data = build_graph(X_raw, y_raw, phi, total_util, d = d, c = c, loo_z = loo_z)\
        \cf5 data = build_graph(X_raw, y_raw, phi, total_util, \cf11 c\cf5 =c, \cf11 loo_z\cf5 =loo_z, \cf11 grad_norm_z\cf5 =grad_norm_z,\
                             \cf11 grad_err_z\cf5 =grad_err_z, \cf11 loss_stats_z \cf5 = loss_stats_z, \cf11 d\cf5 =d)\
        data_list.append(data)\
    \cf4 return \cf5 data_list\
