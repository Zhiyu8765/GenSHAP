'Flip Sign'\
\cf4 def \cf10 flip_pe_sign\cf5 (x, method=\cf6 'sum'\cf5 ):\
    \cf4 assert \cf5 method \cf4 in \cf5 [\cf6 'none'\cf5 , \cf6 'pos'\cf5 , \cf6 'sum'\cf5 , \cf6 'l1'\cf5 , \cf6 'l2'\cf5 , \cf6 'linf'\cf5 , \cf6 'random'\cf5 ]\
    \cf4 if \cf5 method == \cf6 'none'\cf5 :\
        \cf4 return \cf5 x\
    \cf4 elif \cf5 method == \cf6 'random'\cf5 :\
        sign = torch.randint(\cf7 0\cf5 , \cf7 2\cf5 , (x.shape[\cf7 1\cf5 ],))*\cf7 2 \cf5 - \cf7 1\
        \cf4 return \cf5 x * sign\
    fliped_x = -\cf7 1 \cf5 * x\
    \cf4 if \cf5 method == \cf6 'pos'\cf5 :\
        x_v = torch.sum(x >= \cf7 0\cf5 , \cf11 dim\cf5 =\cf7 0\cf5 )\
        fliped_x_v = torch.sum(fliped_x >= \cf7 0\cf5 , \cf11 dim\cf5 =\cf7 0\cf5 )\
    \cf4 elif \cf5 method == \cf6 'sum'\cf5 :\
        x_v = torch.sum(x, \cf11 dim\cf5 =\cf7 0\cf5 )\
        fliped_x_v = torch.sum(fliped_x, \cf11 dim\cf5 =\cf7 0\cf5 )\
    \cf4 elif \cf5 method == \cf6 'linf'\cf5 :\
        x_v, _ = torch.max(x, \cf11 dim\cf5 =\cf7 0\cf5 )\
        fliped_x_v, _ = torch.max(fliped_x, \cf11 dim\cf5 =\cf7 0\cf5 )\
    \cf4 elif \cf5 method == \cf6 'l1'\cf5 :\
        x_pos_mask = x >= \cf7 0\
        \cf5 x_v = torch.norm(x * x_pos_mask, \cf11 dim\cf5 =\cf7 0\cf5 , \cf11 p\cf5 =\cf7 1\cf5 )\
        fliped_x_pos_mask = fliped_x >= \cf7 0\
        \cf5 fliped_x_v = torch.norm(fliped_x * fliped_x_pos_mask, \cf11 dim\cf5 =\cf7 0\cf5 , \cf11 p\cf5 =\cf7 1\cf5 )\
    \cf4 elif \cf5 method == \cf6 'l2'\cf5 :\
        x_pos_mask = x >= \cf7 0\
        \cf5 x_v = torch.norm(x * x_pos_mask, \cf11 dim\cf5 =\cf7 0\cf5 , \cf11 p\cf5 =\cf7 2\cf5 )\
        fliped_x_pos_mask = fliped_x >= \cf7 0\
        \cf5 fliped_x_v = torch.norm(fliped_x * fliped_x_pos_mask, \cf11 dim\cf5 =\cf7 0\cf5 , \cf11 p\cf5 =\cf7 2\cf5 )\
    \cf4 else\cf5 :\
        \cf4 raise \cf8 NotImplementedError\
    \cf5 diff = x_v - fliped_x_v\
    sign = torch.sign(diff)\
    \cf4 return \cf5 x * sign\
\
svd_d = \cf7 100\
\cf9 # FEAT_DIM = svd_d\
## Injection of LOO\
# FEAT_DIM = svd_d + 1\
## Injection of gradient norm and error\
# FEAT_DIM = svd_d + 3\
## Injection of LOO + grad norm + grad error + Local distance-skewness\
