\
        L = torch.stack(losses).mean()\
        loss_history.append(L.item())\
\
        avg_mse = \cf4 None\
        if \cf5 holdout_bases \cf4 and \cf5 base_test_dir:\
            model.eval()\
            \cf12 row \cf5 = \{\cf6 "epoch"\cf5 : ep\}\
            \cf9 # with torch.no_grad():\
            #     catalog = \{it["base_name"]: it for it in discover_datasets(base_test_dir, require_tmc = False)\}\
            #     mses = []\
