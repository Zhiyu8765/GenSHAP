\cf4 def \cf10 SVD_Transform\cf5 (A, d = svd_d):\
    U, S, Vt = np.linalg.svd(A, \cf11 full_matrices\cf5 =\cf4 False\cf5 )\
    k = \cf8 min\cf5 (d, U.shape[\cf7 1\cf5 ])\
    X_svd = U[:, :k] * np.sqrt(S[:k])\
    \cf4 if \cf5 k < d:\
        pad = np.zeros((X_svd.shape[\cf7 0\cf5 ], d - k), \cf11 dtype \cf5 = X_svd.dtype)\
        X_svd = np.concatenate([X_svd, pad], \cf11 axis \cf5 = \cf7 1\cf5 )\
    X_t = torch.tensor(X_svd, \cf11 dtype\cf5 =torch.float)\
    X_t = flip_pe_sign(X_t, \cf11 method\cf5 =\cf6 'sum'\cf5 )\
    \cf4 return \cf5 X_t.numpy()\
