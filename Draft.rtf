        stype = scheduler_type.lower()\
        \cf4 if \cf5 stype == \cf6 "step"\cf5 :\
            scheduler = StepLR(optimizer, \cf11 step_size\cf5 =step_size, \cf11 gamma\cf5 =step_gamma)\
        \cf4 elif \cf5 stype == \cf6 "lambda"\cf5 :\
            \cf4 if \cf5 lambda_fn \cf4 is None\cf5 :\
                lambda_fn = (\cf4 lambda \cf5 ep: \cf7 0.5\cf5 *(\cf7 1 \cf5 + np.cos(np.pi*ep / \cf8 max\cf5 (\cf7 1\cf5 , epochs))))\
            scheduler = LambdaLR(optimizer, \cf11 lr_lambda\cf5 =lambda_fn)\
        \cf4 elif \cf5 stype == \cf6 "none"\cf5 :\
            scheduler = \cf4 None\
        else\cf5 :\
            \cf4 raise \cf8 ValueError\cf5 (\cf6 f"Unknown scheduler_type: \cf4 \{\cf5 scheduler_type\cf4 \}\cf6 "\cf5 )\
\
    loss_history = []\
    per_epoch_rows = []\
\
    \cf4 for \cf5 ep \cf4 in \cf8 range\cf5 (\cf7 1\cf5 , epochs + \cf7 1\cf5 ):\
        model.train()\
        losses = []\
        \cf4 for \cf5 data_list \cf4 in \cf5 dataset_graphs:\
            total_util = data_list[\cf7 0\cf5 ].total_util.to(device)\
            phi_true = data_list[\cf7 0\cf5 ].phi.to(device).view(-\cf7 1\cf5 )\
            N = phi_true.numel()\
            scale = N/total_util\
            phi_true_scaled = phi_true * scale\
            phi_hat_scaled = model(data_list).view(-\cf7 1\cf5 )\
            loss = F.mse_loss(phi_true_scaled, phi_hat_scaled, \cf11 reduction \cf5 = \cf6 "mean"\cf5 )\
            optimizer.zero_grad(\cf11 set_to_none\cf5 =\cf4 True\cf5 )\
            loss.backward()\
