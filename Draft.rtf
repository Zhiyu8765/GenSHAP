\cf4 def \cf10 train_then_diagnose\cf5 (BASE_TRAIN: \cf8 str\cf5 , BASE_TEST: \cf8 str\cf5 , OUT_DIR: \cf8 str\cf5 , holdout_bases,\
                        in_channels = svd_d, hidden_channels = \cf7 256\cf5 , heads = \cf7 8\cf5 ,\
                        epochs = \cf7 500\cf5 , lr = \cf7 1e-4\cf5 , \cf12 weight_decay = 1e-7\cf5 ,\
                        a = \cf7 0.05\cf5 , b = \cf7 0.40\cf5 , ylim = (\cf7 40\cf5 , \cf7 105\cf5 ), random_iters = \cf7 10\cf5 ,\
                        scheduler_type=\cf6 "step"\cf5 , step_size=\cf7 50\cf5 , step_gamma=\cf7 0.5\cf5 , lambda_fn=\cf4 None\cf5 ):\
    _ensure_dir(OUT_DIR)\
\
