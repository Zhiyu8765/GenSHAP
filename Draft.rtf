\cf6 ' Version B. Parallel GIN & GT '\
\cf4 class \cf5 GINShap(torch.nn.Module):\
    \cf4 def \cf13 __init__\cf5 (\cf14 self\cf5 , in_channels, hidden_channels = \cf7 64\cf5 , out_channels = \cf7 1\cf5 , heads = \cf7 2\cf5 ):\
        \cf8 super\cf5 ().\cf13 __init__\cf5 ()\
        \cf4 def \cf10 mlp\cf5 (i, o):\
            \cf4 return \cf5 Sequential(Linear(i, o), LayerNorm(o), ReLU(), Linear(o, o))\
\
        \cf14 self\cf5 .alphas = torch.nn.Parameter(torch.ones(\cf8 len\cf5 (C_List)))\
        \cf14 self\cf5 .betas = torch.nn.Parameter(torch.ones(\cf8 len\cf5 (C_List)))\
        \cf14 self\cf5 .branches = torch.nn.ModuleList()\
        \cf4 for \cf5 _ \cf4 in \cf5 C_List:\
            convs = torch.nn.ModuleList()\
            \cf4 for \cf5 layer \cf4 in \cf8 range\cf5 (\cf7 2\cf5 ):\
                convs.append(\
                    GINConv(mlp(in_channels \cf4 if \cf5 layer == \cf7 0 \cf4 else \cf5 hidden_channels, hidden_channels),\
                            \cf11 aggregator_type \cf5 = \cf6 'sum'\cf5 , \cf11 init_eps \cf5 = \cf7 0.1\cf5 , \cf11 learn_eps \cf5 = \cf4 True\cf5 ,\
                            \cf11 activation \cf5 = ReLU())\
                )\
            \cf14 self\cf5 .branches.append(convs)\
\
        \cf14 self\cf5 .skip_lin = Linear(in_channels, hidden_channels * \cf8 len\cf5 (C_List))\
        d_concat = hidden_channels * \cf8 len\cf5 (C_List)\
\
        encoder_layer = TransformerEncoderLayer(\cf11 d_model\cf5 =d_concat, \cf11 nhead\cf5 =heads, \cf11 dropout\cf5 =\cf7 0.0\cf5 , \cf11 batch_first \cf5 = \cf4 True\cf5 )\
        \cf14 self\cf5 .gt = TransformerEncoder(encoder_layer, \cf11 num_layers \cf5 = \cf7 2\cf5 )\
\
        \cf14 self\cf5 .pre_gt = Linear(in_channels, d_concat)\
\
        \cf14 self\cf5 .Z_gin = Sequential(Linear(d_concat, hidden_channels), ReLU())\
        \cf14 self\cf5 .Z_gt = Sequential(Linear(d_concat, hidden_channels), ReLU())\
\
        \cf14 self\cf5 .out = Sequential(\
            Linear( (hidden_channels * \cf7 2\cf5 ) + \cf7 3\cf5 , hidden_channels * \cf7 2\cf5 ),\
            ReLU(),\
            Linear(hidden_channels * \cf7 2\cf5 , \cf7 100\cf5 ),\
            ReLU(),\
            Linear(\cf7 100\cf5 , out_channels)\
        )\
\
    \cf4 def \cf10 forward\cf5 (\cf14 self\cf5 , data_list):\
        data = data_list[\cf7 0\cf5 ].to(device)\
        x0 = data.x\
        output_GIN = []\
        \cf4 for \cf5 idx, (convs, gdata) \cf4 in \cf8 enumerate\cf5 (\cf8 zip\cf5 (\cf14 self\cf5 .branches, data_list)):\
            node_input = gdata.x.to(device)\
            edge_attr_feat = gdata.edge_attr_feat.view(-\cf7 1\cf5 ).to(device)\
            edge_attr_label = gdata.edge_attr_label.view(-\cf7 1\cf5 ).to(device)\
\
            weights = F.softmax(torch.stack([\cf14 self\cf5 .alphas[idx], \cf14 self\cf5 .betas[idx]]), \cf11 dim\cf5 =\cf7 0\cf5 )\
            edge_weight = weights[\cf7 0\cf5 ] * edge_attr_feat + weights[\cf7 1\cf5 ] * edge_attr_label\
\
            \cf9 ## GPU Version\
            \cf5 g = dgl.graph(\
                (gdata.edge_index[\cf7 0\cf5 ].to(device), gdata.edge_index[\cf7 1\cf5 ].to(device)),\
                \cf11 num_nodes\cf5 =node_input.size(\cf7 0\cf5 ),\cf11 device\cf5 =device\
            )\
\
            \cf9 ## CPU Version\
            # g = dgl.graph(\
            #     (gdata.edge_index[0], gdata.edge_index[1]),\
            #     num_nodes=node_input.size(0)\
            # )\
            \cf5 g.edata[\cf6 'w'\cf5 ] = edge_weight\
\
            \cf4 for \cf5 conv \cf4 in \cf5 convs:\
                node_input = conv(g, node_input, \cf11 edge_weight\cf5 =g.edata[\cf6 'w'\cf5 ])\
            output_GIN.append(node_input)\
\
        gin_cat = torch.cat(output_GIN, \cf11 dim \cf5 = \cf7 1\cf5 )\
        gin_cat = gin_cat + \cf14 self\cf5 .skip_lin(x0)\
\
        h_gin = \cf14 self\cf5 .Z_gin(gin_cat)\
\
        gt_in = \cf14 self\cf5 .pre_gt(x0)\
        gt_in = gt_in.unsqueeze(\cf7 0\cf5 )\
        gt_out = \cf14 self\cf5 .gt(gt_in).squeeze(\cf7 0\cf5 )\
        h_gt = \cf14 self\cf5 .Z_gt(gt_out)\
\
        h_fused = torch.cat([h_gin, h_gt], \cf11 dim\cf5 =\cf7 1\cf5 )\
\
        k_col = data.k_feat\
        h_plus = torch.cat([h_fused, k_col], \cf11 dim \cf5 = \cf7 1\cf5 )\
        \cf4 return \cf14 self\cf5 .out(h_plus)\
\
