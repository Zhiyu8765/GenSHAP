\cf4 def \cf10 _class_styles\cf5 (unique_labels):\
    FILLED = [\cf6 'o'\cf5 ,\cf6 's'\cf5 ,\cf6 '^'\cf5 ,\cf6 'D'\cf5 ,\cf6 'P'\cf5 ,\cf6 '*'\cf5 ,\cf6 'v'\cf5 ,\cf6 '>'\cf5 ,\cf6 '<'\cf5 ,\cf6 'H'\cf5 ]\
    it = cycle(FILLED)\
    styles = \{\}\
    \cf4 for \cf5 cls \cf4 in \cf8 sorted\cf5 (unique_labels):\
        mk = \cf8 next\cf5 (it)\
        styles[cls] = \cf8 dict\cf5 (\cf11 marker\cf5 =mk)\
    \cf4 return \cf5 styles\
