            plt.figure(\cf11 figsize \cf5 = (\cf7 6\cf5 , \cf7 4\cf5 ))\
            plt.plot(df_tt[\cf6 "epoch"\cf5 ], df_tt[\cf6 "avg_mse"\cf5 ], \cf11 label \cf5 = \cf6 "Test(avg MSE)"\cf5 , \cf11 linewidth \cf5 = \cf7 1.2\cf5 , \cf11 alpha \cf5 = \cf7 0.9\cf5 )\
            plt.plot(df_tt[\cf6 "epoch"\cf5 ], df_tt[\cf6 "train_mse"\cf5 ], \cf11 label \cf5 = \cf6 "Train (MSE)"\cf5 , \cf11 linewidth \cf5 = \cf7 1.2\cf5 , \cf11 alpha \cf5 = \cf7 0.9\cf5 )\
            plt.xlabel(\cf6 "Epoch"\cf5 )\
            plt.ylabel(\cf6 "MSE"\cf5 )\
            plt.title(\cf6 'Optimisation Curve of Training & Testing Sets (MSE)'\cf5 )\
