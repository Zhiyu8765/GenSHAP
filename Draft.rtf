\cf4 def \cf10 print_adj_weights\cf5 (model):\
    \cf4 with \cf5 torch.no_grad():\
        \cf8 print\cf5 (\cf6 "\cf4 \\n\cf6 === Learned adjacency weights per c in C_List ==="\cf5 )\
        \cf8 print\cf5 (\cf6 " idx | c | alpha  beta  w_feature  w_label"\cf5 )\
        \cf4 for \cf5 i, c \cf4 in \cf8 enumerate\cf5 (C_List):\
