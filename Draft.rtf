        \cf4 if \cf5 (ep % log_every == \cf7 0\cf5 ) \cf4 or \cf5 (ep == \cf7 1\cf5 ) \cf4 or \cf5 (ep == epochs):\
            \cf4 if \cf5 avg_mse \cf4 is None\cf5 :\
                \cf8 print\cf5 (\cf6 f'Epoch \cf4 \{\cf5 ep\cf4 :\cf6 4d\cf4 \}\cf6  | Train MSE: \cf4 \{\cf5 L.item()\cf4 :\cf6 .10e\cf4 \}\cf6 '\cf5 )\
            \cf4 else\cf5 :\
                \cf8 print\cf5 (\cf6 f'Epoch \cf4 \{\cf5 ep\cf4 :\cf6 4d\cf4 \}\cf6  | Train MSE: \cf4 \{\cf5 L.item()\cf4 :\cf6 .10e\cf4 \}\cf6  | Test MSE: \cf4 \{\cf5 avg_mse\cf4 :\cf6 .10e\cf4 \}\cf6 '\cf5 )\
