\cf4 def \cf10 train\cf5 (model, dataset_graphs, epochs=\cf7 500\cf5 , lr=\cf7 1e-4\cf5 , weight_decay=\cf7 1e-7\cf5 , base_test_dir: \cf8 str \cf5 = \cf4 None\cf5 ,\
          holdout_bases: \cf8 list \cf5 = \cf4 None\cf5 , out_dir: \cf8 str \cf5 = \cf4 None\cf5 , scheduler_type: \cf8 str \cf5 = \cf6 "step"\cf5 , step_size: \cf8 int \cf5 = \cf7 50\cf5 ,\
          step_gamma: \cf8 float \cf5 = \cf7 0.5\cf5 , lambda_fn = \cf4 None\cf5 , log_every: \cf8 int \cf5 = \cf7 5\cf5 ):\
    model.to(device)\
